# Copy this file to .env or set these variables in your system environment.
# Never commit real secrets to the repository.

DOUBAO_API_KEY=replace-with-your-real-key
DOUBAO_BASE_URL=https://your-doubao-compatible-host
DOUBAO_TIMEOUT_SECS=120

# Optional model and endpoint overrides
DOUBAO_VISION_MODEL=your-vision-model-id
DOUBAO_IMAGE_MODEL=your-image-model-id
DOUBAO_RUNTIME_ENDPOINT=
DOUBAO_ANALYZE_ENDPOINT=
DOUBAO_CUTOUT_ENDPOINT=
DOUBAO_FUSION_ENDPOINT=
DOUBAO_ASSETS_ENDPOINT=
DOUBAO_TYPOGRAPHY_ENDPOINT=
